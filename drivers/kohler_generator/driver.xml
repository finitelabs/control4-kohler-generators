<devicedata>
  <name>Kohler Generator</name>
  <version/>
  <manufacturer>Finite Labs</manufacturer>
  <model>Kohler Generator</model>
  <creator>Finite Labs</creator>
  <small image_source="c4z">icons/device_sm.png</small>
  <large image_source="c4z">icons/device_lg.png</large>
  <control>lua_gen</control>
  <driver>DriverWorks</driver>
  <copyright>Copyright 2026 Finite Labs, LLC. All rights reserved.</copyright>
  <created>11/25/2026 12:11:47 AM</created>
  <modified/>
  <minimum_os_version>3.3.0</minimum_os_version>
  <composer_categories>
    <category>Other</category>
  </composer_categories>
  <conditionals>
    <conditional>
      <id>1</id>
      <name>GENERATOR_ONLINE</name>
      <type>BOOL</type>
      <condition_statement>Generator connection</condition_statement>
      <description>NAME is STRING</description>
      <true_text>Online</true_text>
      <false_text>Offline</false_text>
      <sort_order>1</sort_order>
    </conditional>
    <conditional>
      <id>2</id>
      <name>ON_GENERATOR_POWER</name>
      <type>BOOL</type>
      <condition_statement>Power source</condition_statement>
      <description>NAME is on STRING</description>
      <true_text>Generator Power</true_text>
      <false_text>Utility Power</false_text>
      <sort_order>2</sort_order>
    </conditional>
    <conditional>
      <id>3</id>
      <name>GENERATOR_RUNNING</name>
      <type>BOOL</type>
      <condition_statement>Engine running status</condition_statement>
      <description>NAME engine is STRING</description>
      <true_text>Running</true_text>
      <false_text>Not Running</false_text>
      <sort_order>3</sort_order>
    </conditional>
    <conditional>
      <id>4</id>
      <name>GENERATOR_EXERCISING</name>
      <type>BOOL</type>
      <condition_statement>Exercise status</condition_statement>
      <description>NAME is STRING</description>
      <true_text>Exercising</true_text>
      <false_text>Not Exercising</false_text>
      <sort_order>4</sort_order>
    </conditional>
    <conditional>
      <id>5</id>
      <name>GENERATOR_IN_AUTO</name>
      <type>BOOL</type>
      <condition_statement>Switch position</condition_statement>
      <description>NAME switch is STRING</description>
      <true_text>In Auto</true_text>
      <false_text>Not In Auto</false_text>
      <sort_order>5</sort_order>
    </conditional>
    <conditional>
      <id>6</id>
      <name>GENERATOR_FAULT</name>
      <type>BOOL</type>
      <condition_statement>Fault status</condition_statement>
      <description>NAME is STRING</description>
      <true_text>Faulted</true_text>
      <false_text>Not Faulted</false_text>
      <sort_order>6</sort_order>
    </conditional>
    <conditional>
      <id>7</id>
      <name>MAINTENANCE_DUE</name>
      <type>BOOL</type>
      <condition_statement>Maintenance status</condition_statement>
      <description>NAME maintenance is STRING</description>
      <true_text>Due</true_text>
      <false_text>Not Due</false_text>
      <sort_order>7</sort_order>
    </conditional>
  </conditionals>
  <events>
    <event>
      <id>1</id>
      <name>Generator Online</name>
      <description>When NAME is heard from by the KOHLER cloud again</description>
    </event>
    <event>
      <id>2</id>
      <name>Generator Offline</name>
      <description>When NAME stops reaching the KOHLER cloud, or its account is signed out</description>
    </event>
    <event>
      <id>3</id>
      <name>Utility Power Lost</name>
      <description>When the utility power to NAME goes out</description>
    </event>
    <event>
      <id>4</id>
      <name>Utility Power Restored</name>
      <description>When the utility power to NAME comes back</description>
    </event>
    <event>
      <id>5</id>
      <name>Engine Started</name>
      <description>When NAME's engine starts</description>
    </event>
    <event>
      <id>6</id>
      <name>Engine Stopped</name>
      <description>When NAME's engine stops</description>
    </event>
    <event>
      <id>7</id>
      <name>Exercise Started</name>
      <description>When NAME starts an exercise</description>
    </event>
    <event>
      <id>8</id>
      <name>Exercise Ended</name>
      <description>When NAME ends an exercise</description>
    </event>
    <event>
      <id>9</id>
      <name>Fault</name>
      <description>When NAME logs a fault</description>
    </event>
    <event>
      <id>10</id>
      <name>Warning</name>
      <description>When NAME logs a warning</description>
    </event>
    <event>
      <id>11</id>
      <name>Alerts Cleared</name>
      <description>When NAME's last alert clears</description>
    </event>
    <event>
      <id>12</id>
      <name>Switch Not In Auto</name>
      <description>When NAME's switch moves out of Auto</description>
    </event>
    <event>
      <id>13</id>
      <name>Switch Back In Auto</name>
      <description>When NAME's switch moves back to Auto</description>
    </event>
    <event>
      <id>14</id>
      <name>Maintenance Due</name>
      <description>When NAME's maintenance falls due</description>
    </event>
    <event>
      <id>15</id>
      <name>Low Battery</name>
      <description>When NAME logs a low battery</description>
    </event>
  </events>
  <config>
    <script file="driver.lua" jit="1"/>
    <documentation file="www/documentation/index.html"/>
    <properties>
      <property>
        <name>Cloud</name>
        <type>LABEL</type>
        <default>Cloud Settings</default>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Cloud Status</name>
        <default/>
        <type>STRING</type>
        <readonly>true</readonly>
      </property>
      <!-- #endif -->
      <property>
        <name>Automatic Updates</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
      </property>
      <property>
        <name>Generator</name>
        <type>LABEL</type>
        <default>Generator</default>
      </property>
      <property>
        <name>Generator Name</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Auto Rename Driver</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
        <description>Names this driver after the generator's name in the KOHLER app.</description>
      </property>
      <property>
        <name>Model</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Serial Number</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Controller</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Firmware Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Fuel Type</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Connection Type</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Dealer</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Load Control</name>
        <type>LIST</type>
        <items>
          <item>Off</item>
          <item>On</item>
        </items>
        <default>On</default>
        <description>Shows the load-shed loads and lets programming switch them. Set from the generator's first reading.</description>
      </property>
      <property>
        <name>Exercise Schedule</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Last Maintenance</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Next Maintenance</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver</name>
        <type>LABEL</type>
        <default>Driver Settings</default>
      </property>
      <property>
        <name>Driver Status</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Driver Version</name>
        <type>STRING</type>
        <default/>
        <readonly>true</readonly>
      </property>
      <property>
        <name>Log Level</name>
        <type>DYNAMIC_LIST</type>
        <default>3 - Info</default>
      </property>
      <property>
        <name>Log Mode</name>
        <type>LIST</type>
        <default>Off</default>
        <items>
          <item>Off</item>
          <item>Print</item>
          <item>Log</item>
          <item>Print and Log</item>
        </items>
      </property>
      <!-- #ifdef DRIVERCENTRAL -->
      <property>
        <name>Support Code</name>
        <type>STRING</type>
        <default/>
        <description>Enter only a code from Finite Labs support. It opens the Lua window for an hour.</description>
        <password>true</password>
      </property>
      <property>
        <name>Cloud Monitoring</name>
        <type>LIST</type>
        <default>Enabled</default>
        <items>
          <item>Disabled</item>
          <item>Enabled</item>
        </items>
        <description>Sends memory and error reports to Finite Labs so we can fix driver problems.</description>
      </property>
      <!-- #endif -->
    </properties>
    <actions>
      <!-- #ifdef DRIVERCENTRAL -->
      <action>
        <name>Diagnostics Snapshot</name>
        <command>DiagnosticsSnapshot</command>
      </action>
      <!-- #endif -->
    </actions>
    <commands>
      <command>
        <name>Start Exercise</name>
        <description>Start a PARAM1 exercise on NAME</description>
        <params>
          <param>
            <name>Mode</name>
            <type>LIST</type>
            <items>
              <item>Unloaded</item>
              <item>Unloaded Full Speed</item>
              <item>Loaded Full Speed</item>
            </items>
          </param>
        </params>
      </command>
      <command>
        <name>Stop Exercise</name>
        <description>Stop the exercise on NAME</description>
      </command>
      <command>
        <name>Set Exercise Schedule</name>
        <description>Exercise NAME PARAM1 on PARAM2 at PARAM3, PARAM4 for PARAM5 minutes</description>
        <params>
          <param>
            <name>Frequency</name>
            <type>LIST</type>
            <items>
              <item>Weekly</item>
              <item>Every Other Week</item>
              <item>Monthly</item>
            </items>
          </param>
          <param>
            <name>Day</name>
            <type>LIST</type>
            <items>
              <item>Sunday</item>
              <item>Monday</item>
              <item>Tuesday</item>
              <item>Wednesday</item>
              <item>Thursday</item>
              <item>Friday</item>
              <item>Saturday</item>
            </items>
          </param>
          <param>
            <name>Time</name>
            <type>STRING</type>
            <default>10:00 AM</default>
          </param>
          <param>
            <name>Mode</name>
            <type>LIST</type>
            <items>
              <item>Unloaded</item>
              <item>Unloaded Full Speed</item>
              <item>Loaded Full Speed</item>
            </items>
          </param>
          <param>
            <name>Minutes</name>
            <type>RANGED_INTEGER</type>
            <minimum>5</minimum>
            <maximum>60</maximum>
            <default>20</default>
          </param>
        </params>
      </command>
      <!-- Load lists this generator's load-shed loads while Load Control is on (GCPL.Set_Load). -->
      <command>
        <name>Set Load</name>
        <description>Turn NAME load PARAM1 PARAM2</description>
        <params>
          <param>
            <name>Load</name>
            <type>DYNAMIC_LIST</type>
          </param>
          <param>
            <name>State</name>
            <type>LIST</type>
            <items>
              <item>On</item>
              <item>Off</item>
            </items>
          </param>
        </params>
      </command>
      <command>
        <name>Refresh</name>
        <description>Read NAME from KOHLER now</description>
      </command>
    </commands>
  </config>
  <proxies qty="1">
    <proxy proxybindingid="5001" primary="True" name="Kohler Generator" image_source="c4z" large_image="icons/device_lg.png" small_image="icons/device_sm.png">uibutton</proxy>
  </proxies>
